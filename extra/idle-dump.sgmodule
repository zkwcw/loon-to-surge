idle-dump = type=http-response,pattern=^https:\/\/acs\.m\.goofish\.com\/gw\/mtop\.,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/zkwcw/loon-to-surge/main/extra/idle-dump.js

